    "def coord_tile_flat(x: tf.Tensor) -> tf.Tensor:\n",
    "    \"\"\"Tile coordinate input across the flattened LiDAR grid.\n",
    "\n",
    "    Notes:\n",
    "        Expects `x` to have shape `(batch, 2)` or `(batch, 1, 2)`.\n",
    "        A missing middle dimension is inserted when necessary.\n",
    "        Rank mismatches will raise an error.\n",
    "\n",
    "    Args:\n",
    "        x: Coordinate tensor.\n",
    "\n",
    "    Returns:\n",
    "        Tensor tiled to shape `(batch, 4000, 2)`.\n",
    "\n",
    "    Raises:\n",
    "        ValueError: If `x` does not have rank 2 or 3 with middle dimension 1.\n",
    "    \"\"\"\n",
    "    if x.shape.rank == 2:\n",
    "        x = tf.expand_dims(x, axis=1)\n",
    "    elif x.shape.rank != 3 or x.shape[1] != 1:\n",
    "        raise ValueError(\n",
    "            \"Expected rank-2 or rank-3 tensor with middle dimension 1 for coordinates.\"\n",
    "        )\n",
    "    return tf.tile(x, [1, 20 * 200, 1])\n",
    ""
   ]
  },
